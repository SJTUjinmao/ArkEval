# OpenAI-compatible repair/localization endpoint
OPENAI_API_KEY=replace_with_your_key
OPENAI_API_BASE_URL=https://your-endpoint.example/v1
OPENAI_MODEL=replace_with_model_id

# Localization LLM
LOCALIZATION_ENGINE_LLM_API_KEY=replace_with_your_key
LOCALIZATION_ENGINE_LLM_BASE_URL=https://your-endpoint.example/v1
LOCALIZATION_ENGINE_LLM_MODEL=replace_with_model_id

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# Embedding service
LOCALIZATION_ENGINE_EMBEDDING_BACKEND=dgx
LOCALIZATION_ENGINE_DGX_EMBEDDING_BASE_URL=http://127.0.0.1:8008
LOCALIZATION_ENGINE_DGX_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
